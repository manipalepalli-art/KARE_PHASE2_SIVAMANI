import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n,c=0,d,sum = 0;
        while (n != 0) {
        
            n = n/10;
            c++;
        }
        n=temp;
        while(n!=0) {
            d=n%10;
            sum = sum+(int)Math.pow(d,c);
