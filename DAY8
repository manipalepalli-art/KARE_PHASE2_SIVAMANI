3)//write the java program to find the odd,even element count in the given array
 import java.util.*;
 public class Main{
     public static void main(String[] args){
         Scanner sc = new Scanner(System.in);
         int n = sc.nextInt();
         int arr[] = new int[n];
         int i,ec=0,oc=0;
         for(i=0;i<n;i++){
             arr[i]=sc.nextInt();
             if(arr[i]%2==0)
             ec++;
            else
             oc++;
         }
         System.out.println("Even Element Count:"+ec++);
         System.out.println("Odd Element Count:"+oc++);
     }
 }  
