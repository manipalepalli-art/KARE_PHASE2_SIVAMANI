// WRITE THE JAVA PROGRAM TO FIND THE SUM OF POSITIVE AND NEGATIVE ELEMENTS
// I/P                    O/P
// 6
// 10 -20 30 -40 50 -60
// Positive Sum: 90
// Negative Sum: -120
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int i, psum = 0, nsum = 0;
        for(i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
            if(arr[i] > 0)
                psum = psum + arr[i];
            else
                nsum = nsum + arr[i];
        }
        System.out.println("Positive Sum: " + psum);
        System.out.println("Negative Sum: " + nsum);
    }
}
             
