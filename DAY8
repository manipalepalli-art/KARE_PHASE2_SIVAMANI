// WRITE THE JAVA PROGRAM TO COPY ONE ARRAY INTO ANOTHER ARRAY
// I/P                    O/P
// 5
// 10 20 30 40 50         10 20 30 40 50
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr1[] = new int[n];
        int arr2[] = new int[n];
        int i;
        for(i = 0; i < n; i++)
            arr1[i] = sc.nextInt();
        for(i = 0; i < n; i++)
            arr2[i] = arr1[i];
        for(i = 0; i < n; i++)
            System.out.print(arr2[i] + " ");
    }
}

