// WRITE THE JAVA PROGRAM TO PRINT POSITIVE AND NEGATIVE ELEMENTS
// I/P                    O/P
// 6
// 10 -20 30 -40 50 -60
// Positive: 10 30 50
// Negative: -20 -40 -60
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int i;
        for(i = 0; i < n; i++)
            arr[i] = sc.nextInt();
        System.out.print("Positive: ");
        for(i = 0; i < n; i++) {
            if(arr[i] > 0)
                System.out.print(arr[i] + " ");
        }
        System.out.println();
        System.out.print("Negative: ");
        for(i = 0; i < n; i++) {
            if(arr[i] < 0)
                System.out.print(arr[i] + " ");
        }
    }
}

