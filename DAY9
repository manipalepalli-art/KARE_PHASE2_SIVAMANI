//1) single Number
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int i,m = 0;
        for(i=0; i<n; i++){
            arr[i]=sc.nextInt();
            m=m^arr[i];
        }
        System.out.print("Single Number: " + m);
    }
}
//2) missing  Number
//i/p             o/p
//5
//1 3 2 4            5
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n-1];
        int sum = 0;
        for( int i=0; i<n-1; i++){
            arr[i]=sc.nextInt();
            sum = sum+arr[i];
        }
        int sumn=n*(n+1)/2;
        System.out.print("Missing Number: " + (sumn-sum));
    }
}
